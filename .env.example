# Salin menjadi .env dan ganti semua secret sebelum digunakan.
JWT_SECRET=ganti_dengan_secret_jwt_yang_panjang_dan_acak
GATEWAY_SECRET=ganti_dengan_secret_gateway_yang_panjang_dan_acak
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti_dengan_secret_client_yang_panjang_dan_acak
DB_PATH=./database/zero_trust.db
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=1
SERVICE_TOKEN_MINUTES=5
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002
